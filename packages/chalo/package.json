{
  "name": "@osiloke/chalo",
  "version": "2.4.2",
  "description": "A modern React component library for intelligent UI interactions and guided experiences",
  "type": "module",
  "private": false,
  "main": "./dist/chalo.cjs",
  "module": "./dist/chalo.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/chalo.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/chalo.cjs"
      }
    },
    "./theme.css": "./src/theme.css",
    "./theme.dist.css": "./dist/theme.css",
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src/theme.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "component-library",
    "ui",
    "zustand",
    "framer-motion",
    "guided-experience"
  ],
  "author": "Osiloke Harold Emoekpere",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/osiloke/chalo.git",
    "directory": "packages/chalo"
  },
  "peerDependencies": {
    "framer-motion": ">=12.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-hook-form": ">=7.0.0",
    "zustand": ">=5.0.0"
  },
  "scripts": {
    "build": "npm run build:types && npm run build:css && vite build && npm run copy:types",
    "build:types": "tsc --project tsconfig.json",
    "build:css": "npx @tailwindcss/cli --input ./src/theme.css --output ./dist/theme.dist.css --minify",
    "copy:types": "cp dist/types/index.d.ts dist/types/index.d.mts",
    "dev": "npm run build:types && vite build --watch",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 --config ../../.eslintrc.cjs",
    "lint:fix": "eslint . --ext ts,tsx --fix --config ../../.eslintrc.cjs",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "prepack": "cp -f ../../README.md ./README.md && cp -f ../../LICENSE ./LICENSE",
    "prepublishOnly": "vitest run --passWithNoTests && npm run build"
  },
  "devDependencies": {
    "@testing-library/react": "^15.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^1.6.0",
    "@vitest/ui": "^1.6.0",
    "clsx": "^2.1.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "framer-motion": "^12.38.0",
    "jsdom": "^29.0.1",
    "lucide-react": "^1.7.0",
    "prettier": "^3.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^1.6.0",
    "zustand": "^5.0.12"
  }
}