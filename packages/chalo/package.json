{
  "name": "chalo",
  "version": "0.1.0",
  "description": "A modern React component library for intelligent UI interactions and guided experiences",
  "type": "module",
  "private": false,
  "main": "./dist/chalo.cjs",
  "module": "./dist/chalo.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/chalo.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/chalo.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "react",
    "component-library",
    "ui",
    "zustand",
    "framer-motion",
    "guided-experience"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/chalo.git",
    "directory": "packages/chalo"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "zustand": ">=5.0.0",
    "framer-motion": ">=12.0.0"
  },
  "scripts": {
    "build": "npm run build:types && vite build && npm run copy:types",
    "build:types": "tsc --project tsconfig.json",
    "copy:types": "cp dist/types/index.d.ts dist/types/index.d.mts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "vitest run && npm run build"
  },
  "devDependencies": {
    "@testing-library/react": "^15.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^1.6.0",
    "@vitest/ui": "^1.6.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "framer-motion": "^12.38.0",
    "prettier": "^3.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^1.6.0",
    "zustand": "^5.0.12"
  }
}