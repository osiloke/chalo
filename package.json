{
  "name": "chalo-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm --filter chalo-demo dev",
    "build:chalo": "pnpm --filter chalo build",
    "build:demo": "pnpm --filter chalo-demo build",
    "build": "pnpm build:chalo && pnpm build:demo",
    "test": "pnpm --filter chalo test",
    "test:ui": "pnpm --filter chalo test:ui",
    "coverage": "pnpm --filter chalo coverage",
    "lint": "pnpm --filter chalo lint",
    "lint:fix": "pnpm --filter chalo lint:fix",
    "format": "pnpm --filter chalo format",
    "format:fix": "pnpm --filter chalo format:fix",
    "publish:chalo": "pnpm --filter chalo publish"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "react-hook-form": "^7.72.1",
    "semantic-release": "^25.0.3",
    "tailwind-merge": "^3.5.0",
    "typescript": "^6.0.2"
  }
}