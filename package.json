{
  "name": "chalo-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/demo",
    "build:chalo": "npm run build -w packages/chalo",
    "build:demo": "npm run build -w apps/demo",
    "build": "npm run build:chalo && npm run build:demo",
    "test": "npm run test -w packages/chalo",
    "test:ui": "npm run test:ui -w packages/chalo",
    "coverage": "npm run coverage -w packages/chalo",
    "lint": "npm run lint -w packages/chalo",
    "lint:fix": "npm run lint:fix -w packages/chalo",
    "format": "npm run format -w packages/chalo",
    "format:fix": "npm run format:fix -w packages/chalo",
    "publish:chalo": "npm publish -w packages/chalo"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  }
}